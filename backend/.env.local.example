DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CHAT_PATH=/chat/completions

# Speech-to-text (OpenAI-compatible POST .../audio/transcriptions). Mirror ai-no-note / your provider.
# ASR_DEFAULT_PROVIDER=auto
# Whisper-style (defaults below target api.openai.com if OPENAI_API_KEY set):
# ASR_WHISPER_BASE_URL=https://api.openai.com/v1
# ASR_WHISPER_API_KEY=
# ASR_WHISPER_MODEL=whisper-1
# ASR_WHISPER_TRANSCRIPTION_PATH=/audio/transcriptions
# StepFun / Challenger-style:
# ASR_CHALLENGER_BASE_URL=https://api.stepfun.com/v1
# ASR_CHALLENGER_API_KEY=
# ASR_CHALLENGER_MODEL=step-asr
# Optional: raise cap if needed (bytes, default 31457280 = 30MB)
# INTERVIEW_RECORDING_MAX_UPLOAD_BYTES=31457280

# If an API key was ever pasted into chat or committed, rotate it at the provider console and store only in this file (never commit .env.local).

MYSQL_URL=jdbc:mysql://localhost:3306/ai_coding_analysis?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=root


# StepFun ASR (OpenAI-compatible /audio/transcriptions; same as ai-no-note)
ASR_DEFAULT_PROVIDER=auto
STEPFUN_BASE_URL=https://api.stepfun.com/v1
STEPFUN_API_KEY=xxx
STEPFUN_ASR_MODEL=step-asr
STEPFUN_TRANSCRIPTION_PATH=/audio/transcriptions
