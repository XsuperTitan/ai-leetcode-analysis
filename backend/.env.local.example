DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CHAT_PATH=/chat/completions

MYSQL_URL=jdbc:mysql://localhost:3306/ai_coding_analysis?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# 语音转写（OpenAI 兼容：POST {base}/audio/transcriptions，multipart: model、response_format=json、file）
# 与 ai-no-note 对齐：ASR_DEFAULT_PROVIDER=auto 时，若 StepFun（Challenger）配全则优先，否则 Whisper。
# ASR_DEFAULT_PROVIDER=auto
#
# Whisper / OpenAI 风格：
# ASR_WHISPER_BASE_URL=https://api.openai.com/v1
# ASR_WHISPER_API_KEY=your_key_here
# ASR_WHISPER_MODEL=whisper-1
# ASR_WHISPER_TRANSCRIPTION_PATH=/audio/transcriptions
#
# StepFun（Challenger）也可用别名变量（与 application.yml 中 asr.challenger 绑定）：
# STEPFUN_BASE_URL=https://api.stepfun.com/v1
# STEPFUN_API_KEY=your_stepfun_api_key_here
# STEPFUN_ASR_MODEL=step-asr
# STEPFUN_TRANSCRIPTION_PATH=/audio/transcriptions
#
# 面试录音上传大小上限（字节，默认 30MB）：
# INTERVIEW_RECORDING_MAX_UPLOAD_BYTES=31457280
#
# 切勿将真实密钥提交到 Git；仅保留在本机 backend/.env.local。
